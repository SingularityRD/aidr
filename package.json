{
	"private": true,
	"license": "Proprietary",
	"type": "module",
	"packageManager": "pnpm@10.29.3",
	"pnpm": {
		"overrides": {
			"@hono/node-server": "2.0.12",
			"brace-expansion": "2.1.4",
			"express-rate-limit": "8.2.2",
			"fast-uri": "3.1.7",
			"hono": "4.13.5",
			"ip-address": "10.3.1",
			"path-to-regexp": "8.4.0",
			"protobufjs": "7.6.5",
			"qs": "6.16.0",
			"react-router": "7.18.2",
			"react-router-dom": "7.18.2",
			"uuid": "11.1.1",
			"ws": "8.21.2",
			"body-parser": "2.3.0",
			"langsmith": "0.6.0"
		},
		"onlyBuiltDependencies": [
			"koffi"
		]
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"compile:aig": "node scripts/compile-aig-data.mjs",
		"aig:verify": "node --test scripts/verify-aig-source.test.mjs && node scripts/verify-aig-source.mjs",
		"sync:aig": "node scripts/sync-aig-threats.mjs",
		"postinstall": "node scripts/compile-aig-data.mjs",
		"build": "node scripts/build-workspace.mjs",
		"build:release": "node scripts/build-workspace.mjs --release",
		"quality:gate": "pnpm quality:static && pnpm audit:prod && pnpm check && pnpm test && pnpm test:coverage && pnpm build:release",
		"test": "pnpm test:investor-metrics && vitest run",
		"test:ci": "pnpm test:investor-metrics && node scripts/run-tests-ci.mjs",
		"verify:enforcement": "node scripts/verify-enforcement.mjs",
		"verify:codex": "node scripts/verify-codex-hook.mjs",
		"features:inventory": "node scripts/generate-feature-inventory.mjs",
		"prompt:next-agent": "node scripts/generate-next-agent-execution-prompt.mjs",
		"verify:next-agent-prompt": "node scripts/verify-next-agent-execution-prompt.mjs",
		"deploy:prepare": "node scripts/deployment-prepare.mjs",
		"deploy:migrate": "node scripts/deployment-migrate.mjs",
		"deploy:smoke": "node scripts/deployment-smoke.mjs",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "node scripts/run-e2e-release.mjs",
		"test:e2e:negative": "node scripts/run-e2e-negative-credentials.mjs",
		"test:e2e:claude": "vitest run --config vitest.e2e.config.ts packages/claude-code",
		"test:e2e:openclaw": "vitest run --config vitest.e2e.config.ts packages/openclaw",
		"test:e2e:opencode": "vitest run --config vitest.e2e.config.ts packages/opencode",
		"test:opencode:aidr": "pnpm --filter @singularityrd/aidr-opencode run test:aidr-contract",
		"test:e2e:cursor": "vitest run --config vitest.e2e.config.ts packages/extension",
		"test:e2e:vscode": "vitest run --config vitest.e2e.config.ts packages/extension",
		"test:customer-demo": "pnpm test:opencode:aidr && pnpm test -- packages/dashboard/src/__tests__/integration.test.tsx --run && pnpm -C packages/dashboard build && pnpm -C packages/dashboard run test:route-smoke:static",
		"test:watch": "vitest",
		"test:investor-metrics": "node --test scripts/validate-investor-metric-dictionary.test.mjs",
		"test:perf": "vitest run --reporter=verbose --reporter=json --outputFile=coverage/test-results.json",
		"test:perf:analyze": "node scripts/track-test-perf.mjs",
		"audit:prod": "node scripts/audit-production-deps.mjs",
		"package:consumers": "node scripts/check-package-consumers.mjs",
		"verify:package-install": "node scripts/verify-package-install.mjs",
		"quality:static": "pnpm lint && pnpm benchmark:test && pnpm knip && pnpm duplicates && node scripts/check-mandatory-skips.mjs && pnpm verify:investor-metrics && node scripts/check-commercial-surface.mjs && node scripts/verify-commercial-compliance.mjs && node scripts/check-supabase-edge-contracts.mjs && node scripts/demo-preflight.mjs --static && pnpm test:monthly-sli && pnpm verify:monthly-sli",
		"demo:preflight": "node scripts/demo-preflight.mjs",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"check": "pnpm --filter @singularityrd/aidr-core run build && pnpm -r --filter \"./packages/*\" --filter \"!@singularityrd/aidr-mcp-gateway\" exec tsc --noEmit && node --check packages/mcp-gateway/src/gateway.mjs && node --check packages/mcp-gateway/src/cli.mjs && node --check packages/mcp-gateway/src/approve.mjs && node --check packages/mcp-gateway/src/stdio.mjs && node --check packages/mcp-gateway/src/stdio-cli.mjs",
		"supabase:check": "node scripts/check-supabase-migrations.mjs",
		"build:sea": "bash packages/claude-code/scripts/build-sea.sh",
		"package:vsix": "pnpm -C packages/extension run package:vsix",
		"clean": "pnpm -r run clean",
		"changeset": "changeset",
		"version": "changeset version && node scripts/sync-manifests.mjs",
		"release": "pnpm build:release && pnpm changeset publish",
		"build:analyze": "pnpm -r run build:analyze",
		"sentry:upload": "node scripts/upload-sourcemaps.mjs",
		"knip": "node scripts/run-knip-gate.mjs",
		"knip:raw": "knip",
		"knip:fix": "knip --fix",
		"duplicates": "jscpd --threshold 10",
		"deploy:bootstrap": "node scripts/deployment-bootstrap.mjs",
		"deploy:doctor": "node scripts/deployment-doctor.mjs",
		"deploy:backup": "node scripts/deployment-backup.mjs",
		"deploy:backup:offsite": "node scripts/deployment-backup-offsite.mjs",
		"deploy:restore:drill": "node scripts/deployment-restore-drill.mjs",
		"deploy:upgrade": "node scripts/deployment-upgrade.mjs",
		"deploy:offboarding": "node scripts/deployment-offboarding.mjs",
		"support:bundle": "node scripts/support-bundle.mjs",
		"load:test": "node scripts/load-test.mjs",
		"sli:monthly": "node scripts/monthly-sli-report.mjs",
		"test:monthly-sli": "node --test scripts/monthly-sli-report.test.mjs",
		"verify:monthly-sli": "node scripts/verify-monthly-sli-report.mjs",
		"verify:sli": "node scripts/verify-monthly-sli-report.mjs",
		"release:sign": "node scripts/release-sign.mjs",
		"release:verify": "node scripts/release-verify.mjs",
		"verify:fleet:windows": "node scripts/verify-windows-fleet.mjs",
		"verify:fleet:unix": "node scripts/verify-unix-fleet-delivery.mjs",
		"verify:native-host": "node scripts/verify-native-host-matrix-v6.mjs",
		"verify:native-host:validate": "node scripts/verify-native-host-matrix-v6.mjs --scenario-file deploy/native/scenarios/TEMPLATE.json --validate-only",
		"verify:interception-matrix": "node deploy/native/verify-interception-matrix.mjs",
		"benchmark:test": "node --test scripts/benchmarks/*.test.mjs",
		"benchmark:scope": "node scripts/benchmarks/evaluate.mjs --corpus scripts/benchmarks/corpus.template.json --scope-file scripts/benchmarks/sold-scope.json",
		"verify:monitoring": "node --test deploy/monitoring/monitoring.test.mjs",
		"verify:upgrade": "node scripts/verify-deployment-upgrade.mjs",
		"verify:support-bundle": "node scripts/verify-support-bundle.mjs --self-test",
		"verify:load": "node scripts/verify-load-test.mjs",
		"verify:release-signing": "node --test scripts/release-signing.test.mjs",
		"verify:provenance": "node --test scripts/provenance.test.mjs",
		"verify:airgap-images": "node --test scripts/airgap-images.test.mjs",
		"verify:customer-kit": "node --test scripts/customer-kit-verify.test.mjs",
		"verify:repo-hygiene": "node scripts/verify-repo-hygiene.mjs",
		"verify:endpoint-auth": "node scripts/verify-endpoint-auth-matrix.mjs",
		"verify:backup-offsite": "node --test scripts/deployment-backup-offsite.test.mjs",
		"verify:offboarding": "node --test scripts/deployment-offboarding.test.mjs scripts/tenant-offboarding-migration.test.mjs scripts/billing-offboarding-postgres.test.mjs",
		"verify:retention": "node --test scripts/deployment-maintenance.test.mjs scripts/retention-holds-postgres.test.mjs",
		"verify:bootstrap": "node --test scripts/deployment-bootstrap.test.mjs",
		"verify:endpoint-auth-matrix": "node --test scripts/verify-endpoint-auth-matrix.test.mjs",
		"verify:commercial-gates": "node scripts/verify-commercial-gate-receipts.mjs",
		"verify:investor-metrics": "node scripts/validate-investor-metric-dictionary.mjs",
		"verify:commercial-compliance": "node scripts/verify-commercial-compliance.mjs",
		"test:commercial-compliance": "node --test scripts/verify-commercial-compliance.test.mjs",
		"package:customer": "node scripts/customer-kit.mjs",
		"evidence:index": "node scripts/generate-v8-evidence-index.mjs",
		"evidence:index:verify": "node scripts/generate-v8-evidence-index.mjs --verify",
		"verify:customer-onboarding": "node scripts/verify-customer-onboarding.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@changesets/cli": "^2.29.8",
		"@vitest/coverage-v8": "^4.0.0",
		"jscpd": "^4.0.5",
		"knip": "^5.46.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.2",
		"vitest-teamcity-reporter": "^0.4.1"
	}
}

