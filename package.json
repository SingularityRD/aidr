{
	"private": true,
	"license": "Proprietary",
	"type": "module",
	"packageManager": "pnpm@10.29.3",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"scan:build": "node scripts/build-scan-index.mjs",
		"scan:sync": "node scripts/sync-scan-rules.mjs",
		"postinstall": "node scripts/build-scan-index.mjs",
		"build": "pnpm scan:build && pnpm -r run build",
		"build:release": "pnpm scan:build && pnpm -C packages/core run build:release && pnpm -r --filter \"!@singularityrd/aidr-core\" run build:release && node scripts/release-artifact-manifests.mjs && node scripts/check-no-sourcemaps.mjs packages && node scripts/check-no-leaky-paths.mjs packages/core/dist packages/claude-code/dist packages/extension/dist packages/openclaw/dist packages/opencode/dist packages/dashboard/dist",
		"quality:gate": "pnpm lint && pnpm check && pnpm test && pnpm test:coverage && pnpm build:release",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm test:e2e:claude && pnpm test:e2e:openclaw && pnpm test:e2e:opencode && pnpm test:e2e:cursor && pnpm test:e2e:vscode",
		"test:e2e:claude": "vitest run --config vitest.e2e.config.ts packages/claude-code",
		"test:e2e:openclaw": "vitest run --config vitest.e2e.config.ts packages/openclaw",
		"test:e2e:opencode": "vitest run --config vitest.e2e.config.ts packages/opencode",
		"test:e2e:cursor": "vitest run --config vitest.e2e.config.ts packages/extension",
		"test:e2e:vscode": "vitest run --config vitest.e2e.config.ts packages/extension",
		"test:watch": "vitest",
		"test:perf": "vitest run --reporter=verbose --reporter=json --outputFile=coverage/test-results.json",
		"test:perf:analyze": "node scripts/track-test-perf.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "pnpm -r exec tsc --noEmit",
		"build:sea": "bash packages/claude-code/scripts/build-sea.sh",
		"package:vsix": "pnpm -C packages/extension run package:vsix",
		"clean": "pnpm -r run clean",
		"changeset": "changeset",
		"version": "changeset version && node scripts/sync-manifests.mjs",
		"build:analyze": "pnpm -r run build:analyze",
		"sentry:upload": "node scripts/upload-sourcemaps.mjs",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"duplicates": "jscpd --threshold 10"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@changesets/cli": "^2.29.8",
		"@vitest/coverage-v8": "^4.0.0",
		"jscpd": "^4.0.5",
		"knip": "^5.46.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.2",
		"vitest-teamcity-reporter": "^0.4.1"
	}
}
