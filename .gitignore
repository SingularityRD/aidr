!packages/claude-code/dist/session-start.cjs
!packages/claude-code/dist/mcp-server.cjs
# health.cjs is the package's declared `bin` entry, so it is a shipped artifact.
# Without this negation the build creates an untracked file and the CI
# "enforce clean diff after verification/build" step fails.
!packages/claude-code/dist/health.cjs
packages/extension/resources/
packages/claude-code/resources/
packages/extension/.vsce/
*.vsix
*.tsbuildinfo
*.blob
bin/
packages/openclaw/resources/
packages/opencode/resources/
packages/sdk/resources/

