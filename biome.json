{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["packages/*/src/**", "!packages/*/src/generated/*.json"]
	},
	"linter": {
		"rules": {
			"recommended": false,
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn",
				"noForEach": "off",
				"noStaticOnlyClass": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noNonNullAssertedOptionalChain": "warn",
				"useIterableCallbackReturn": "warn",
				"noDuplicateTestHooks": "warn"
			},
			"performance": {
				"noAccumulatingSpread": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/core/src/dlp/privacy-rules/**"],
			"formatter": { "enabled": false },
			"linter": { "enabled": false },
			"assist": { "enabled": false }
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["packages/privacy/src/**"],
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		}
	]
}
