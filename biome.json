{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"packages/*/src/**",
			"!packages/*/src/generated/*.json",
			"!packages/*/src/generated/*.ts"
		]
	},
	"linter": {
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn",
				"noForEach": "off",
				"noStaticOnlyClass": "error"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noNonNullAssertedOptionalChain": "error",
				"useIterableCallbackReturn": "error",
				"noDuplicateTestHooks": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["packages/core/src/dlp/privacy-rules/**"],
			"formatter": { "enabled": false },
			"linter": { "enabled": false },
			"assist": { "enabled": false }
		},
		{
			"includes": ["packages/privacy/src/**"],
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		}
	]
}
