# Singularity AIDR Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env files to version control!

# =============================================================================
# E2E Testing Configuration
# =============================================================================

# Anthropic API key for Claude Code E2E tests (required for test:e2e:claude)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenClaw gateway token for E2E tests (required for test:e2e:openclaw)
# Alternatively, read from ~/.openclaw/openclaw.json
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# OpenClaw E2E host URL (default: http://localhost:18789)
OPENCLAW_E2E_HOST=http://localhost:18789

# Model for OpenClaw E2E tests (default: claude-3-5-haiku-latest)
OPENCLAW_E2E_MODEL=claude-3-5-haiku-latest

# OpenCode CLI binary path for E2E tests (default: opencode)
OPENCODE_E2E_BIN=opencode

# Enable verbose E2E test output (set to "true")
AIDR_E2E_VERBOSE=true

# E2E target host for extension tests (default: localhost)
AIDR_E2E_HOST=localhost
AIDR_E2E_TARGET=localhost

# Enable IDE Extension Host E2E tests (set to "1" to enable)
# Requires installed Cursor/VS Code executables
AIDR_E2E_ENABLE_IDE_HOST=1

# Headless agent model for Cursor E2E tests (default: claude-4.5-sonnet)
AIDR_HEADLESS_AGENT_MODEL=claude-4.5-sonnet

# =============================================================================
# IDE Executable Paths (Optional - for custom installations)
# =============================================================================

# Custom Cursor executable path (optional, auto-detected if not set)
AIDR_CURSOR_PATH=/Applications/Cursor.app/Contents/MacOS/Cursor

# Custom VS Code executable path (optional, auto-detected if not set)
AIDR_VSCODE_PATH=/Applications/Visual Studio Code.app/Contents/MacOS/Electron
VSCODE_EXECUTABLE_PATH=/Applications/Visual Studio Code.app/Contents/MacOS/Electron

# Agent CLI path for headless Cursor tests (optional)
AIDR_AGENT_PATH=/usr/local/bin/agent

# VS Code Node.js executable path (used by extension)
VSCODE_NODE_EXEC_PATH=/usr/local/bin/node

# XDG base directories are auto-detected from the user home directory.
# Set XDG_CONFIG_HOME / XDG_CACHE_HOME only to absolute paths when needed.

# =============================================================================
# Observability Configuration
# =============================================================================

# Sentry Configuration
# External error reporting requires explicit opt-in and a real DSN.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DEBUG=false
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Logging Configuration
AIDR_LOG_LEVEL=info
AIDR_LOG_TO_FILE=false
# The app expands leading ~/; Node --env-file does not interpolate shell variables.
AIDR_LOG_FILE_PATH=~/.singularity-aidr/logs/aidr.log

# Metrics Configuration
AIDR_METRICS_FILE=~/.singularity-aidr/metrics.jsonl
AIDR_DISABLE_METRICS=false

# URL Check Endpoint
AIDR_URL_CHECK_ENDPOINT=https://api.singularityrd.com/v1/url-check

# =============================================================================
# Payment Provider Configuration (Multi-Provider Billing)
# =============================================================================

# Stripe (adopted billing provider; replaces the removed Lemon Squeezy integration)
#
# STATUS: supabase/functions/stripe-webhook is implemented and unit-tested but
# NOT deployed, and no Stripe secret is provisioned. The values below are
# placeholders only - never commit real keys.
# Get keys from: https://dashboard.stripe.com/apikeys
# Get the endpoint signing secret from: https://dashboard.stripe.com/webhooks
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe webhook tuning (Supabase Edge Function secrets, not browser variables)
# Replay tolerance in seconds for the Stripe-Signature timestamp (default 300).
# A missing/non-numeric value falls back to 300; it never disables the check.
AIDR_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Stripe price id of the paid extra-agent line item. Seat grants are refused
# (fail-closed, no entitlement write) while this is unset.
AIDR_STRIPE_EXTRA_AGENT_PRICE_ID=price_REPLACE_ME
# Provider adapter used by the billing portal. Set to `stripe` only together
# with the shared self-service gate and all Stripe credentials below.
AIDR_BILLING_PROVIDER=
# Shared self-service gate for the Paddle and Stripe webhook/checkout endpoints.
# Direct-GA is invoice/order based, so this stays false unless a separately
# approved commercial decision enables self-service billing.
AIDR_ENABLE_LEGACY_SELF_SERVICE_BILLING=false

# iyzico (Turkey)
# Get from: https://merchant.iyzico.com/
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SANDBOX=true

# Coinbase Commerce (Crypto/Privacy)
# Get from: https://commerce.coinbase.com/
COINBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
COINBASE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# PayPal (Global Fallback)
# Get from: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_WEBHOOK_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend URL for payment callbacks
NEXT_PUBLIC_URL=http://localhost:3000
