# Copy to a local .env.posture-scanner and fill the blank values before
# starting Compose. Never commit credentials or signing material.
#
# `scripts/deployment-prepare.mjs --with-posture-scanner` writes these values
# (with generated secrets) into the prepared installation's private .env
# instead; this file is for running docker-compose.posture-scanner.yml directly
# from a source checkout.
POSTURE_SCANNER_SOURCE_VERSION=v4.6.1-aidr.1
POSTURE_SCANNER_AGENT_SHARED_SECRET=
POSTURE_SCANNER_SIGNING_PUBLIC_KEY_HOST_PATH=
POSTURE_SCANNER_TRUSTED_SIGNING_KEY_ID=
POSTURE_SCANNER_TRUSTED_SIGNING_PUBLIC_KEY_SHA256=
POSTURE_SCANNER_EXPECTED_DATA_BUNDLE_ID=
POSTURE_SCANNER_EXPECTED_SOURCE_COMMIT=
BRIDGE_AUTH_MODE=api_key
BRIDGE_API_KEY=
# Optional Prometheus scrape token for the bridge GET /metrics (empty = disabled).
# Use its own random value; never reuse BRIDGE_API_KEY. See deploy/monitoring/.
BRIDGE_METRICS_TOKEN=

# Single-host defaults (no action needed): durable SQLite task registry on the
# bridge state volume, HA not required, and remote scan traffic through the
# shipped deny-by-default egress gateway. Add authorized scan domains to
# deploy/onprem/egress/allowlist.txt (or point
# POSTURE_SCANNER_EGRESS_ALLOWLIST_PATH at a reviewed copy); an empty allowlist
# refuses every remote scan.
BRIDGE_TASK_BACKEND=sqlite
BRIDGE_HA_REQUIRED=false
BRIDGE_EGRESS_PROXY_URL=http://aig-egress:3128
# POSTURE_SCANNER_EGRESS_ALLOWLIST_PATH=./deploy/onprem/egress/allowlist.txt

# PostgreSQL HA switch (multi-replica bridge). Apply
# services/aig-bridge/migrations/001_postgres_task_registry.sql and
# 002_postgres_jwt_replay.sql first, then set all three:
# BRIDGE_HA_REQUIRED=true
# BRIDGE_TASK_BACKEND=postgres
# BRIDGE_TASK_POSTGRES_DSN=postgresql://bridge:<secret>@postgres.internal/aidr?sslmode=verify-full

# Broker (JWT) authentication instead of the isolated API key:
# BRIDGE_AUTH_MODE=broker
# BRIDGE_JWT_SECRET=
# BRIDGE_JWT_ISSUER=
# BRIDGE_JWT_AUDIENCE=
