			<string>C918896B-A461-5819-B591-B776F68ED5BD</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>Chrome: install AIDR Browser Guard</string>
			<key>PayloadEnabled</key>
			<true/>
			<key>ExtensionInstallForcelist</key>
			<array>
				<string>REPLACE_WITH_CHROME_EXTENSION_ID;https://clients2.google.com/service/update2/crx</string>
			</array>
			<key>ExtensionSettings</key>
			<dict>
				<key>REPLACE_WITH_CHROME_EXTENSION_ID</key>
				<dict>
					<key>installation_mode</key>
					<string>force_installed</string>
