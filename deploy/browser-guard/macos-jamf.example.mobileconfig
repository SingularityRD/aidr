	<key>PayloadUUID</key>
	<string>31357147-5AE5-5CD7-B92D-EC1DE3C91091</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadDisplayName</key>
	<string>Singularity AIDR Browser Guard</string>
	<key>PayloadDescription</key>
	<string>Installs Singularity AIDR Browser Guard in Google Chrome and Microsoft Edge and sets its managed policy. Example: replace the REPLACE_WITH_* placeholders before upload.</string>
	<key>PayloadOrganization</key>
	<string>Singularity R&amp;D</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadContent</key>
	<array>
