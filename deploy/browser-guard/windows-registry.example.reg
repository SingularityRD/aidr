Windows Registry Editor Version 5.00

; Singularity AIDR Browser Guard: example machine policy for Google Chrome and Microsoft Edge.
; Replace the REPLACE_WITH_* placeholders, then import with: reg import windows-registry.example.reg
; Scalars are REG_SZ / REG_DWORD; lists and objects are REG_SZ JSON strings (Chrome and Edge accept
; JSON-encoded values for array and object keys of an extension managed-storage schema).

; ---- Google Chrome ----
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"1"="REPLACE_WITH_CHROME_EXTENSION_ID;https://clients2.google.com/service/update2/crx"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\3rdparty\extensions\REPLACE_WITH_CHROME_EXTENSION_ID\policy]
"policyId"="acme-browser-guard-2026-09"
"mode"="auto"
"enabledEntities"="[\"PERSON\",\"EMAIL\",\"PHONE\",\"TC_KIMLIK\",\"IBAN\",\"CREDIT_CARD\",\"ADDRESS\",\"US_SSN\",\"DATE_OF_BIRTH\",\"PASSPORT\",\"NATIONAL_ID\",\"TAX_ID\",\"BANK_ACCOUNT\",\"IP_ADDRESS\",\"MAC_ADDRESS\",\"SECRET\",\"PRIVATE_KEY\",\"INTERNAL\",\"CLASSIFIED\",\"HEALTH_ID\",\"LICENSE_PLATE\"]"
"neverRestore"="[\"SECRET\",\"PRIVATE_KEY\"]"
"literals"="[{\"value\":\"Project Nightingale\",\"type\":\"INTERNAL\"},{\"value\":\"ACME-CONFIDENTIAL\",\"type\":\"CLASSIFIED\"}]"
"exactData"="[{\"datasetId\":\"crm-customers-example\",\"keyB64\":\"o6J5dv/ZMVjrraODjOrMuCsIQzqswQczrGPSl/aB6bU=\",\"fingerprints\":[\"7284cb51429e3ff4e4d9b0cc1cee1276631d01aacc98cd83b3f39847a747fa36\",\"dace37df0e61d972ce461b5887cc8ef241df0749dd737adc7de1b118305d89b2\",\"fd5d74d29c57fd1c18a6d23aa82f83ea8211081ed570ae9ac60b90f7e4b71180\"],\"type\":\"PERSON\"}]"
"detectSignals"=dword:00000001
"signalAction"="warn"
"blockedSites"="[\"deepseek\"]"
"disabledSites"="[]"
"allowUserPause"=dword:00000000
"allowSendAnyway"=dword:00000000
"maskPaste"=dword:00000001
"fileHandling"="scan"
"maxFileBytes"=dword:00500000
"restoreResponses"=dword:00000001
"useNativeHost"=dword:00000000
"telemetry"="{\"controlPlaneUrl\":\"https://aidr.example.com\",\"apiKey\":\"REPLACE_WITH_TENANT_API_KEY\"}"
"language"="auto"

; ---- Microsoft Edge ----
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist]
"1"="REPLACE_WITH_EDGE_EXTENSION_ID;https://edge.microsoft.com/extensionwebstorebase/v1/crx"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\3rdparty\extensions\REPLACE_WITH_EDGE_EXTENSION_ID\policy]
"policyId"="acme-browser-guard-2026-09"
"mode"="auto"
"enabledEntities"="[\"PERSON\",\"EMAIL\",\"PHONE\",\"TC_KIMLIK\",\"IBAN\",\"CREDIT_CARD\",\"ADDRESS\",\"US_SSN\",\"DATE_OF_BIRTH\",\"PASSPORT\",\"NATIONAL_ID\",\"TAX_ID\",\"BANK_ACCOUNT\",\"IP_ADDRESS\",\"MAC_ADDRESS\",\"SECRET\",\"PRIVATE_KEY\",\"INTERNAL\",\"CLASSIFIED\",\"HEALTH_ID\",\"LICENSE_PLATE\"]"
"neverRestore"="[\"SECRET\",\"PRIVATE_KEY\"]"
"literals"="[{\"value\":\"Project Nightingale\",\"type\":\"INTERNAL\"},{\"value\":\"ACME-CONFIDENTIAL\",\"type\":\"CLASSIFIED\"}]"
"exactData"="[{\"datasetId\":\"crm-customers-example\",\"keyB64\":\"o6J5dv/ZMVjrraODjOrMuCsIQzqswQczrGPSl/aB6bU=\",\"fingerprints\":[\"7284cb51429e3ff4e4d9b0cc1cee1276631d01aacc98cd83b3f39847a747fa36\",\"dace37df0e61d972ce461b5887cc8ef241df0749dd737adc7de1b118305d89b2\",\"fd5d74d29c57fd1c18a6d23aa82f83ea8211081ed570ae9ac60b90f7e4b71180\"],\"type\":\"PERSON\"}]"
"detectSignals"=dword:00000001
"signalAction"="warn"
"blockedSites"="[\"deepseek\"]"
"disabledSites"="[]"
"allowUserPause"=dword:00000000
"allowSendAnyway"=dword:00000000
"maskPaste"=dword:00000001
"fileHandling"="scan"
"maxFileBytes"=dword:00500000
"restoreResponses"=dword:00000001
"useNativeHost"=dword:00000000
"telemetry"="{\"controlPlaneUrl\":\"https://aidr.example.com\",\"apiKey\":\"REPLACE_WITH_TENANT_API_KEY\"}"
"language"="auto"
