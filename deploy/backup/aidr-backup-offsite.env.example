# This file contains references and policy, never recovery-key or S3 secret bytes.
AIDR_BACKUP_TARGET=s3://company-backups/aidr/production
AIDR_BACKUP_KEY_REFERENCE=hsm://security/aidr-production-recovery
AIDR_BACKUP_RETENTION_DAYS=35
AIDR_BACKUP_S3_REGION=eu-central-1
# Set for a non-AWS S3-compatible provider.
# AIDR_BACKUP_S3_ENDPOINT=https://s3.eu.example.invalid
# Requires an Object-Lock-enabled bucket. Allowed values: GOVERNANCE, COMPLIANCE.
AIDR_BACKUP_S3_OBJECT_LOCK_MODE=COMPLIANCE
