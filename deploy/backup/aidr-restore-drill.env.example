# Policy and public references only. Never put key or provider credential bytes here.
AIDR_RESTORE_KIT_ROOT=/srv/aidr-staging/aidr-kit-1
AIDR_RESTORE_TARGET=s3://company-backups/aidr/production
AIDR_RESTORE_RUNTIME=/srv/aidr-reviewed-runtime
AIDR_RESTORE_CANDIDATE_INVENTORY=/srv/aidr-release-candidate/release-inventory.json
AIDR_RESTORE_CANDIDATE_POLICY=/etc/aidr/release-signer-policy.json
AIDR_RESTORE_EVIDENCE_RETENTION_DAYS=90
AIDR_RESTORE_RPO_TARGET_MINUTES=REPLACE_WITH_APPROVED_MINUTES
AIDR_RESTORE_RTO_TARGET_SECONDS=REPLACE_WITH_APPROVED_SECONDS
