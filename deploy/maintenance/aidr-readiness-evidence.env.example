# Copy to /srv/aidr/.env.readiness with mode 0600.
AIDR_DEPLOYMENT_DIR=/srv/aidr
AIDR_HEALTH_STATE_DIR=/srv/aidr/health
AIDR_SIGNING_KEY_EXPIRES_AT=REPLACE_WITH_UTC_EXPIRY
AIDR_DELEGATION_SIGNING_KEY_EXPIRES_AT=REPLACE_WITH_UTC_EXPIRY
# A real authenticated fleet aggregator must create a 64-hex queue namespace
# below this explicit root before the systemd installer will activate the timer.
AIDR_TELEMETRY_QUEUE_ROOTS=REPLACE_WITH_ROOT_UNDER_VAR_LIB_AIDR_TELEMETRY
# If enabled, the config's state_file must be under /var/lib/aidr-siem.
# SINGULARITY_AIDR_SIEM_CONFIG_PATH=/etc/aidr/siem-delivery.json
AIDR_DRAIN_SIEM=true
