{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularityrd.example/schemas/aidr-native-support-matrix-v1.json",
  "title": "Singularity AIDR native host support matrix",
  "description": "Published contract for deploy/native/support-matrix.json. The normative validator is validateMatrix() in deploy/native/run-support-matrix.mjs: this schema is never loaded at run time, never decides a release, and deploy/native/run-support-matrix.test.mjs asserts that every required/properties entry below agrees with the constants that validator uses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "reviewedAt",
    "decision",
    "decisionMeaning",
    "soldConnectorScope",
    "soldPlatformScope",
    "soldArchitectureScope",
    "soldDeploymentProfiles",
    "interceptionPointVocabulary",
    "rows",
    "residual"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "aidr-native-support-matrix" },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the advertised scope was last reviewed by a human."
    },
    "decision": {
      "const": "NO-GO",
      "description": "A support matrix records scope, not success: it stays NO-GO until every row has named real-host acceptance."
    },
    "decisionMeaning": { "type": "string", "minLength": 1 },
    "soldConnectorScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "soldPlatformScope": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["windows", "linux", "macos"] }
    },
    "soldArchitectureScope": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["x64", "arm64"] }
    },
    "soldDeploymentProfiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "interceptionPointVocabulary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "residual": {
      "type": "array",
      "items": { "$ref": "#/$defs/residual" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "hostBinary",
        "hostBinaryEnvOverride",
        "interceptionPoint",
        "outputInterceptionPoint",
        "tamperResistance",
        "supportedPlatforms",
        "supportedArchitectures",
        "supportedContexts",
        "installPath",
        "uninstallPath",
        "supportOwnerRole",
        "knownBypasses",
        "unobservedActions",
        "acceptanceEvidence"
      ],
      "properties": {
        "connector": { "type": "string", "minLength": 1 },
        "hostBinary": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "hostBinaryEnvOverride": {
          "oneOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, { "type": "null" }]
        },
        "interceptionPoint": { "type": "string", "minLength": 1 },
        "outputInterceptionPoint": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "tamperResistance": { "type": "string", "minLength": 1 },
        "supportedPlatforms": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["windows", "linux", "macos"] }
        },
        "supportedArchitectures": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["x64", "arm64"] }
        },
        "supportedContexts": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["user", "service"] }
        },
        "installPath": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "uninstallPath": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "supportOwnerRole": { "type": "string", "minLength": 3 },
        "knownBypasses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unobservedActions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptanceEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "ownerRole", "requiredInput", "acceptanceCommand", "acceptanceEvidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "ownerRole": { "type": "string", "minLength": 1 },
        "requiredInput": { "type": "string", "minLength": 1 },
        "acceptanceCommand": { "type": "string", "minLength": 1 },
        "acceptanceEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
