# Public path references only. Review a private copy at /etc/aidr/operations.env.
# This does not configure signing, SMTP, TLS, backup credentials or queue sources.
AIDR_KIT_ROOT=/opt/aidr-kit
AIDR_DEPLOYMENT_DIR=/srv/aidr
AIDR_OPERATIONS_EVIDENCE=/var/lib/aidr-operations
AIDR_CANDIDATE_INVENTORY=/opt/aidr-kit/artifacts/release-inventory.json
AIDR_CANDIDATE_POLICY=/etc/aidr/release-signer-policy.json
# Use an independently prepared, reviewed runtime from this exact signed candidate.
AIDR_RESTORE_RUNTIME=/srv/aidr-reviewed-runtime
AIDR_RESTORE_WORK_ROOT=/var/lib/aidr-restore-drill
AIDR_RECOVERY_KEY_FILE=/etc/aidr/aidr-recovery.key
AIDR_LOAD_BASE_URL=https://console.customer.example
# Load runs require explicit host authorization. Match the base URL exactly.
AIDR_LOAD_ALLOWED_HOST=console.customer.example
