scrape_configs:
  - job_name: aidr-control-plane
    scheme: http
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/aidr_metrics_token
    static_configs:
      - targets:
          - dashboard:8080
    scrape_interval: 15s
    scrape_timeout: 5s

rule_files:
  - prometheus-alerts.yml
