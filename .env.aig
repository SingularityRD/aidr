# =============================================================================
# AIG (AI-Infra-Guard) Environment Configuration
# =============================================================================
# Loaded by docker compose when running: docker compose --env-file .env.aig up
# =============================================================================

# ── AIG Server ──────────────────────────────────────────────────────────────
AIG_SERVER_PORT=8088
# Loopback by default because upstream AIG v4.5.1 has no authentication.
# Set only behind a private, authenticated ingress.
AIG_BIND_ADDRESS=127.0.0.1
AIG_SOURCE_VERSION=v4.5.1
AIG_TZ=Asia/Shanghai

# ── AIG Bridge ──────────────────────────────────────────────────────────────
AIG_BRIDGE_PORT=8099
BRIDGE_LOG_LEVEL=INFO
BRIDGE_API_KEY=
BRIDGE_AUTH_MODE=broker
BRIDGE_AUTH_REQUIRED=true
BRIDGE_JWT_SECRET=
BRIDGE_JWT_ISSUER=
BRIDGE_JWT_AUDIENCE=aidr-aig-bridge
BRIDGE_JWT_REPLAY_DB=/app/state/jwt-replay.db
BRIDGE_TENANT_REQUIRED=true
BRIDGE_HA_REQUIRED=true
BRIDGE_TASK_BACKEND=postgres
BRIDGE_TASK_BACKEND_READY=false
BRIDGE_REQUIRE_IDEMPOTENCY=true
BRIDGE_RUNTIME_EGRESS_REQUIRED=true
BRIDGE_EGRESS_PROXY_URL=
BRIDGE_WORKER_HEALTH_REQUIRED=true
BRIDGE_UPLOAD_ENABLED=true
BRIDGE_UPLOAD_ROOT=/app/uploads
BRIDGE_CORS_ORIGINS=
BRIDGE_ALLOW_PRIVATE_TARGETS=false
BRIDGE_VALIDATE_DNS=true
BRIDGE_SOURCE_ROOT=/app/uploads

# ── Agent Workers ───────────────────────────────────────────────────────────
# Worker identity is generated per process; the shared secret must be supplied
# by the deployment secret manager.  A missing secret/readiness assertion keeps
# the bridge fail-closed until an attested worker pool is provisioned.
AIG_AGENT_COUNT=2
AIG_AGENT_SHARED_SECRET=
AIG_WORKER_READY=false
AIG_MIN_WORKERS=2
AIG_DATASET_READINESS_REQUIRED=true
AIG_DATASET_MANIFEST_SHA256=
AIG_DATASET_LOADED_SHA256=
