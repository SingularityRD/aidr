* text=auto eol=lf
# Preserve the owned AIG Git tree byte-for-byte, including upstream Markdown hardbreaks.
vendor/ai-infra-guard/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
*.bat text eol=crlf
*.ps1 text eol=crlf
# Generated connector bundles can contain intentional whitespace inside
# embedded third-party documentation strings; source files remain strict.
packages/claude-code/dist/*.cjs whitespace=-space-before-tab
