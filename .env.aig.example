# Copy to a local .env.aig and fill the blank values before starting Compose.
# Never commit credentials or signing material.
AIG_SOURCE_VERSION=v4.6.1
AIG_AGENT_SHARED_SECRET=
AIG_SIGNING_PUBLIC_KEY_HOST_PATH=
AIG_TRUSTED_SIGNING_KEY_ID=
AIG_TRUSTED_SIGNING_PUBLIC_KEY_SHA256=
AIG_EXPECTED_DATA_BUNDLE_ID=
AIG_EXPECTED_SOURCE_COMMIT=
BRIDGE_EGRESS_PROXY_URL=
BRIDGE_AUTH_MODE=api_key
BRIDGE_API_KEY=

# HA or JWT deployments also set these in the local .env.aig:
# BRIDGE_TASK_POSTGRES_DSN=
# BRIDGE_JWT_SECRET=
# BRIDGE_JWT_ISSUER=
# BRIDGE_JWT_AUDIENCE=
