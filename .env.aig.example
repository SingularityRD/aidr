# Copy to a local .env.aig and fill the blank values before starting Compose.
# Never commit credentials or signing material.
#
# `scripts/deployment-prepare.mjs --with-aig` writes these values (with generated
# secrets) into the prepared installation's private .env instead; this file is
# for running docker-compose.aig.yml directly from a source checkout.
AIG_SOURCE_VERSION=v4.6.1-aidr.1
AIG_AGENT_SHARED_SECRET=
AIG_SIGNING_PUBLIC_KEY_HOST_PATH=
AIG_TRUSTED_SIGNING_KEY_ID=
AIG_TRUSTED_SIGNING_PUBLIC_KEY_SHA256=
AIG_EXPECTED_DATA_BUNDLE_ID=
AIG_EXPECTED_SOURCE_COMMIT=
BRIDGE_AUTH_MODE=api_key
BRIDGE_API_KEY=

# Single-host defaults (no action needed): durable SQLite task registry on the
# bridge state volume, HA not required, and remote scan traffic through the
# shipped deny-by-default egress gateway. Add authorized scan domains to
# deploy/onprem/egress/allowlist.txt (or point AIG_EGRESS_ALLOWLIST_PATH at a
# reviewed copy); an empty allowlist refuses every remote scan.
BRIDGE_TASK_BACKEND=sqlite
BRIDGE_HA_REQUIRED=false
BRIDGE_EGRESS_PROXY_URL=http://aig-egress:3128
# AIG_EGRESS_ALLOWLIST_PATH=./deploy/onprem/egress/allowlist.txt

# PostgreSQL HA switch (multi-replica bridge). Apply
# services/aig-bridge/migrations/001_postgres_task_registry.sql and
# 002_postgres_jwt_replay.sql first, then set all three:
# BRIDGE_HA_REQUIRED=true
# BRIDGE_TASK_BACKEND=postgres
# BRIDGE_TASK_POSTGRES_DSN=postgresql://bridge:<secret>@postgres.internal/aidr?sslmode=verify-full

# Broker (JWT) authentication instead of the isolated API key:
# BRIDGE_AUTH_MODE=broker
# BRIDGE_JWT_SECRET=
# BRIDGE_JWT_ISSUER=
# BRIDGE_JWT_AUDIENCE=
