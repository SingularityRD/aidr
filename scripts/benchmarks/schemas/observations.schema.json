{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularityrd.example/schemas/benchmark-observations-v1.json",
  "title": "AIDR T39 observations (descriptive; evaluate.mjs is normative)",
  "type": "object",
  "required": ["schema_version", "workload_id", "environment", "trials_per_case", "candidate_product_id", "products", "measurements"],
  "properties": {
    "schema_version": { "const": 1 }, "workload_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "object", "required": ["environment_id", "os", "hardware", "runtime", "region", "concurrency", "workload_description"] },
    "trials_per_case": { "type": "integer", "minimum": 1 }, "candidate_product_id": { "type": "string", "minLength": 1 },
    "products": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/product" } },
    "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } },
    "measurement_budget": { "type": "object", "required": ["currency", "ceiling", "spent"], "properties": { "currency": { "type": "string", "minLength": 1 }, "ceiling": { "type": "number", "minimum": 0 }, "spent": { "type": "number", "minimum": 0 }, "authorization_ref": { "type": ["string", "null"], "description": "Opaque external reference; presence is not verification or authorization." } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "product": { "type": "object", "required": ["product_id", "version", "artifact_sha256"], "properties": { "product_id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "artifact_sha256": { "$ref": "#/$defs/sha256" }, "comparison_unknown_reason": { "enum": ["not_authorized", "not_available", "budget_blocked", "missing_measurements", "unsupported_product"] } } },
    "measurement": { "type": "object", "required": ["case_id", "product_id", "trial", "action", "phase", "latency_ms", "raw_evidence_file", "raw_evidence_sha256"], "properties": { "case_id": { "type": "string" }, "product_id": { "type": "string" }, "trial": { "type": "integer", "minimum": 1 }, "action": { "enum": ["block", "approval", "allow", "unsupported", "timeout", "error"] }, "phase": { "enum": ["cold_local", "warm_local", "remote_reputation", "policy_refresh", "output_inspection"] }, "latency_ms": { "type": ["number", "null"], "minimum": 0 }, "raw_evidence_file": { "type": "string", "minLength": 1 }, "raw_evidence_sha256": { "$ref": "#/$defs/sha256" }, "score": { "type": "number", "minimum": 0, "maximum": 1 } } }
  }
}
