{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularityrd.example/schemas/benchmark-comparison-spec-v1.json",
  "title": "AIDR T39 frozen comparison specification",
  "type": "object",
  "required": ["schema_version", "kind", "spec_id", "frozen", "cells", "unknown_reasons", "access_blockage", "rule"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "aidr-benchmark-comparison-contract" },
    "spec_id": { "type": "string", "minLength": 1 },
    "frozen": { "const": true },
    "cells": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "description", "coverage_rate"] } },
    "unknown_reasons": { "type": "object", "minProperties": 1 },
    "access_blockage": { "type": "object", "required": ["required_for_reasons", "evidence_path_field", "evidence_sha256_field", "rule"] },
    "rule": { "type": "string", "minLength": 1 }
  }
}
