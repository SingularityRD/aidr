{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularityrd.example/schemas/benchmark-corpus-v1.json",
  "title": "AIDR T39 benchmark corpus (descriptive; evaluate.mjs is normative)",
  "type": "object",
  "required": ["schema_version", "corpus_id", "version", "rule_author_id", "oracle_reviewer_id", "scope", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "$ref": "#/$defs/nonempty" },
    "version": { "$ref": "#/$defs/nonempty" },
    "provenance": { "enum": ["synthetic_open", "customer_supplied"] },
    "rule_author_id": { "$ref": "#/$defs/nonempty" },
    "oracle_reviewer_id": { "$ref": "#/$defs/nonempty" },
    "scope": {
      "type": "object",
      "required": ["required_attack_families", "required_connectors", "required_surfaces"],
      "properties": {
        "required_attack_families": { "$ref": "#/$defs/nonemptyStrings" },
        "required_connectors": { "$ref": "#/$defs/nonemptyStrings" },
        "required_surfaces": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "nonemptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "case": {
      "type": "object",
      "required": ["case_id", "partition", "oracle", "family", "connector", "surface", "content_sha256"],
      "properties": {
        "case_id": { "$ref": "#/$defs/nonempty" }, "partition": { "enum": ["development", "holdout"] },
        "oracle": { "enum": ["malicious", "benign"] }, "family": { "$ref": "#/$defs/nonempty" },
        "connector": { "$ref": "#/$defs/nonempty" }, "surface": { "$ref": "#/$defs/nonempty" },
        "content_sha256": { "$ref": "#/$defs/sha256" }, "content": { "type": "string", "minLength": 1 }
      }
    }
  }
}
