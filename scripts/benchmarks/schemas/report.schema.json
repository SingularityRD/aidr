{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singularityrd.example/schemas/benchmark-report-v1.json",
  "title": "AIDR T39 report (descriptive; evaluate.mjs is normative)",
  "type": "object",
  "required": ["schema_version", "kind", "claim_status", "production_accepted", "corpus", "observations_sha256", "workload_id", "environment", "attestation", "coverage", "gates", "canonical_report_sha256"],
  "properties": {
    "schema_version": { "const": 1 }, "kind": { "const": "aidr_independent_benchmark_analysis" },
    "claim_status": { "const": "EVIDENCE_REVIEW_REQUIRED" }, "production_accepted": { "const": false },
    "corpus": { "type": "object" }, "observations_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "workload_id": { "type": "string" }, "environment": { "type": "object" }, "attestation": { "type": "object" },
    "measurement_budget": { "type": "object", "required": ["status", "authorization_ref", "authorization_verified", "amount", "trials", "host_minutes", "currency"], "properties": { "status": { "const": "BLOCKED_EXTERNAL" }, "refusal_reason": { "const": "authorization_not_verified" }, "authorization_ref": { "type": ["string", "null"] }, "authorized": { "const": false }, "authorization_verified": { "const": false }, "amount": { "type": ["number", "null"], "minimum": 0 }, "trials": { "type": ["integer", "null"], "minimum": 1 }, "host_minutes": { "type": ["number", "null"], "minimum": 0 }, "currency": { "type": ["string", "null"] } } },
    "coverage": { "type": "object" }, "gates": { "type": "object", "properties": { "independent_acceptance": { "const": false }, "attestation_trusted": { "type": "boolean" }, "holdout_frozen": { "type": "boolean" } } },
    "canonical_report_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
