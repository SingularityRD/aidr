{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				".github/scripts/*.mjs",
				"deploy/backup/deployment-backup-health-failed.mjs",
				"deploy/dashboard/server.mjs",
				"deploy/privacy-gateway/healthcheck.mjs",
				"deploy/fleet/unix/aidr-remediate.mjs",
				"deploy/fleet/unix/fleet-health.mjs",
				"deploy/fleet/unix/remove-managed-hooks.mjs",
				"deploy/helm/build-images.mjs",
				"deploy/helm/generate-secrets.mjs",
				"docs/scripts/claim-check.mjs",
				"scripts/benchmarks/generate-corpus.mjs",
				"scripts/benchmarks/split-corpus.mjs",
				"scripts/apply-dependency-bump.mjs",
				"scripts/build-airgap-images.mjs",
				"scripts/build-release-candidate.mjs",
				"scripts/check-generator-determinism.mjs",
				"scripts/dashboard-security-headers.mjs",
				"scripts/check-no-leaky-paths.mjs",
				"scripts/check-package-contracts.mjs",
				"scripts/customer-kit-verify.mjs",
				"scripts/deployment-maintenance.mjs",
				"scripts/encrypt-intel-pack-file.mjs",
				"scripts/intel-pack-keys.mjs",
				"scripts/license-revocations-issue.mjs",
				"scripts/endpoint-install.mjs",
				"scripts/generate-provenance.mjs",
				"scripts/generate-production-sales-gap-audit.mjs",
				"scripts/generate-sbom.mjs",
				"scripts/list-open-findings.mjs",
				"scripts/privacy-canary.config.mjs",
				"scripts/privacy-verify.mjs",
				"scripts/refresh-claim-evidence.mjs",
				"scripts/release-artifact-manifests.mjs",
				"scripts/release-evidence-regression.mjs",
				"scripts/resource-profile-preload.cjs",
				"scripts/resource-profile.mjs",
				"scripts/run-evidence-gates.mjs",
				"scripts/run-ide-host-e2e.mjs",
				"scripts/real-host-e2e/crash-hook.mjs",
				"scripts/sign-artifact-manifest.mjs",
				"scripts/sync-governance-frameworks.mjs",
				"scripts/verify-customer-kit.mjs",
				"scripts/verify-codex-host-offline.mjs",
				"scripts/verify-support-ticket-drill.mjs",
				"scripts/verify-deployment-recovery.mjs",
				"scripts/verify-enterprise-operations.mjs",
				"scripts/verify-installation-tools.mjs",
				"scripts/verify-model-interception-live.mjs",
				"scripts/verify-noisy-neighbor-live.mjs",
				"scripts/verify-policy-fleet-pagination.mjs",
				"scripts/verify-policy-rollout.mjs",
				"scripts/verify-release-evidence.mjs",
				"scripts/verify-url-check-live.mjs",
				"supabase/functions/__tests__/policy-rings.vitest.config.ts",
				"supabase/functions/*/index.ts",
				"supabase/tests/policy-draft-validate.mjs",
				"vitest.control-plane.config.ts",
				"vitest.dlp-storage.config.ts",
				"vitest.e2e.config.ts"
			],
			"project": [
				".github/scripts/**/*.{js,cjs,mjs,ts}",
				"deploy/**/*.{js,cjs,mjs,ts}",
				"docs/scripts/**/*.{js,cjs,mjs,ts}",
				"scripts/**/*.{js,cjs,mjs,ts}",
				"supabase/functions/**/*.{js,mjs,ts}",
				"supabase/tests/**/*.{js,mjs,ts}",
				"*.{js,cjs,mjs,ts}"
			],
			"ignore": ["deploy/upstream/**", "vendor/**", "deploy/helm/aidr/files/**"],
			"ignoreDependencies": ["npm", "playwright-core"],
			"ignoreBinaries": ["bash", "docker", "dpkg-deb", "du", "gh", "gitleaks", "go", "icacls.exe", "npm.cmd", "psql", "where.exe", "wrangler"]
		},
		"packages/core": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts", "*.{js,mjs,ts}"]
		},
		"packages/claude-code": {
			"entry": [
				"src/pre-tool-use.ts",
				"src/post-tool-use.ts",
				"src/mcp-server.ts",
				"src/session-start.ts",
				"src/health.ts",
				"src/user-prompt-submit.ts",
				"src/response-worker.ts"
			],
			"project": ["src/**/*.ts", "scripts/**/*.{js,mjs}", "*.{js,mjs,ts}"]
		},
		"packages/browser-guard": {
			"entry": [
				"src/background/index.ts",
				"src/content/index.ts",
				"src/ui/popup.ts",
				"src/ui/options.ts",
				"src/content/main-world.ts",
				"e2e/fixtures/kit.js"
			],
			"project": ["src/**/*.ts", "scripts/**/*.mjs", "e2e/**/*.{js,mjs}"]
		},
		"packages/cli": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts", "*.{js,mjs,ts}"]
		},
		"packages/codex": {
			"entry": ["src/index.ts", "src/cli.ts"],
			"project": ["src/**/*.ts", "scripts/**/*.{js,mjs}", "*.{js,mjs,ts}"]
		},
		"packages/dashboard": {
			"entry": ["src/main.tsx"],
			"project": ["src/**/*.{ts,tsx}", "*.{js,mjs,ts}"]
		},
		"packages/extension": {
			"entry": ["src/cursor_extension.ts", "src/vscode_extension.ts", "src/aidr-hook.ts"],
			"project": ["src/**/*.ts", "scripts/**/*.{js,mjs}", "*.{js,cjs,mjs,ts}"],
			"ignoreDependencies": ["koffi"]
		},
		"packages/mcp-gateway": {
			"entry": ["src/cli.mjs", "src/approve.mjs", "src/stdio-cli.mjs", "src/library.mjs"],
			"project": ["src/**/*.mjs", "scripts/**/*.mjs"]
		},
		"packages/openclaw": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts", "scripts/**/*.{js,mjs}", "*.{js,mjs,ts}"]
		},
		"packages/opencode": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts", "scripts/**/*.{js,mjs}", "*.{js,mjs,ts}"]
		},
		"packages/privacy": {
			"entry": [
				"src/index.ts",
				"src/visual/index.ts",
				"src/browser/index.ts",
				"src/enterprise/index.ts",
				"src/platform/index.ts",
				"src/cli.ts",
				"src/visual/cli.ts",
				"src/native/host.ts",
				"extension/src/service-worker.ts",
				"extension/src/content-entry.ts",
				"extension/src/compose.ts",
				"portal/app.js",
				"deployment/generate.mjs",
				"deployment/container-service-config.mjs",
				"native/prepare-host.mjs",
				"examples/**/*.mjs",
				"scripts/**/*.mjs",
				"tests/extension/*.ts",
				"tests/extension/dom-harness.js",
				"tests/fixtures/mock-ner.mjs"
			],
			"project": [
				"src/**/*.ts",
				"extension/src/**/*.ts",
				"extension/*.ts",
				"portal/**/*.js",
				"deployment/**/*.mjs",
				"native/**/*.mjs",
				"examples/**/*.mjs",
				"scripts/**/*.mjs",
				"tests/**/*.{mjs,js,ts}"
			],
			"ignoreBinaries": ["openssl"],
			"ignoreIssues": { "package.json": ["optionalPeerDependencies"] }
		},
		"packages/sdk": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts", "scripts/**/*.{js,mjs}", "*.{js,mjs,ts}"]
		}
	},
	"ignoreIssues": {
		"packages/opencode/src/index.ts": ["duplicates"],
		"scripts/stage-windows-koffi.mjs": ["unlisted"],
		"scripts/sync-dlp-edge-schema.mjs": ["unlisted"],
		"scripts/sync-agent-profile-edge-schema.mjs": ["unlisted"],
		"packages/core/src/dlp/privacy-rules/**": ["exports", "types"]
	}
}
