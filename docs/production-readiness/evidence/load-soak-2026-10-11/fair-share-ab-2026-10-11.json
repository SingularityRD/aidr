 },
 "result": {
  "collapse_56_rps": "every off-arm run collapsed (goodput 11.0-25.8 HTTP 200/s, quiet error ratio 54-81%, client timeouts and drops); every on-arm run held 48.1-53.8 HTTP 200/s with no timeouts or drops",
  "collapse_52_rps": "the off arm collapsed in the v1 and v2 windows (goodput 18.7-40.5, quiet errors 21-62%) but not in the v3 window (52.0 / 51.9, quiet errors 0 / 0.23%): host capacity moved between windows, so 52 rps was not above the knee then. In that window the on arm cost the quiet tenant 0.93% retryable 429s with similar p95 (0.93 / 1.00 s against 1.08 / 1.59 s)",
  "quiet_errors_on_arm": "v1 0-0.87% (503 service_overloaded), v2 0.93-1.30% (429 and 503), v3 0.65-0.93% (429 tenant_overloaded charged to the shared unresolved bucket, plus one 500); never a timeout",
  "quiet_p95_on_arm": "v1 1.68-2.92 s, v2 0.48-1.00 s, v3 0.63-1.00 s; collapsed off arms 10.0 s",
  "noisy_on_arm": "429 tenant_overloaded 33-695 per run plus a few 503 service_overloaded, all with Retry-After: 1",
  "bound": "MISSED in every on-arm run of every iteration (error ratio <= 0.1%, zero quiet 429/503, p95 <= 241 ms)",
  "why": "per-isolate state: under overload the runtime retires each function's isolate every few seconds on its CPU-time soft limit, so counts and key-to-tenant hints restart at zero while the retiring isolate drains its own admitted requests. The bound is per isolate, not per runtime instance; the quiet key's first request in each fresh isolate competes in the shared unresolved bucket; and admitted work from several overlapping isolates still queues on one 10-connection pool and one host CPU, which fair-share admission does not schedule"
 }
