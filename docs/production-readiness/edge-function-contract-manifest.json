{
  "$comment": "AIDR-019: every Edge Function the dashboard invokes from browser code must appear here with the contract test that exercises it. scripts/check-supabase-edge-contracts.mjs enumerates the real call sites with the TypeScript AST and fails when a browser-invoked function is absent, so an unlisted invocation cannot slip in. A `tests: []` entry is an explicit, recorded gap and is reported as such on every gate run; it is never silently treated as covered.",
  "policy": {
    "browserCalledFunctionsRequireContractTest": true,
    "unenumeratedFunctionIsFailure": true,
    "dynamicFunctionNameIsFailure": true,
    "emptyTestListIsReported": true,
    "gateMustMatchBrowserCallSites": true
  },
