    {
      "id": "POV-001",
      "domain": "customer-validation",
      "requirement": "A named customer or investor evaluator completes the signed Evaluation Charter, independent sandbox/PoV, mandatory scenarios, limitations review, and acceptance/reservations for the same Release Candidate.",
      "decisionProfiles": ["evaluation", "assisted-sale", "production-ga", "investor"],
      "class": "hard",
      "status": "open",
      "ownerRole": "Customer Success + Product + evaluator",
      "automatedCheck": "expected-suite manifest and evidence-index completeness; acceptance is manual",
