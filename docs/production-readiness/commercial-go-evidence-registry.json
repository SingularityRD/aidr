    {
      "id": "CLM-001",
      "domain": "claims",
      "requirement": "All customer, investor, procurement, landing, README, plugin, and sales claims are mapped to the Claim Registry; only approved, unexpired claims appear on release-facing surfaces.",
      "decisionProfiles": ["evaluation", "assisted-sale", "production-ga", "investor"],
