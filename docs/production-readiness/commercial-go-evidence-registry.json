      "id": "COM-010",
      "domain": "ga-connectors",
      "requirement": "Direct-GA scope includes every advertised connector: Claude Code, Cursor, VS Code, OpenClaw, and OpenCode. Each connector has a supported-host matrix, signed artifact, private-registry install path, real-host E2E, rollback, support owner, and limitations.",
      "decisionProfiles": ["evaluation", "assisted-sale", "production-ga", "investor"],
