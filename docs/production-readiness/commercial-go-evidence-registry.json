{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "registryKind": "commercial-go-evidence",
  "decision": "NO-GO",
  "releaseCandidate": null,
  "lastReviewed": "2026-08-04",
  "commercialDecision": {
    "status": "locked-product-decision-evidence-open",
    "launchModel": "direct-ga",
    "connectorScope": "all-connectors",
    "deploymentModel": "hybrid",
    "regions": ["EU", "US", "APAC"],
    "billingModel": "enterprise-invoice",
    "distribution": "private-registry",
    "sla": {
      "target": "99.9% monthly availability",
      "scope": "managed control plane and dashboard API",
      "status": "contract-evidence-open",
      "measurement": "monthly SLI with published exclusions, denominator, maintenance policy, service credits, and incident evidence"
    },
    "lockedMeaning": "These are the intended commercial choices. They are not a claim that the implementation, contracts, regions, registry, or SLA evidence is complete."
  },
  "templatePaths": [
    "docs/production-readiness/commercial-release-manifest-template.md",
    "docs/production-readiness/enterprise-order-entitlement-template.md",
    "docs/production-readiness/support-sla-template.md",
    "docs/production-readiness/privacy-legal-review-template.md",
    "docs/production-readiness/investor-metric-dictionary-template.md"
  ],
  "policy": {
    "hardBlockerMeans": "No sale, production release, or investor claim may rely on an open hard item.",
    "externalEvidenceCannotBeInferred": true,
    "nonWaivableClasses": [
      "critical vulnerability",
      "tenant isolation failure",
      "silent mandatory-suite omission",
      "unknown deployed revision",
      "unrecoverable customer data",
      "falsified or placeholder evidence",
      "unapproved legal, privacy, licensing, or pricing claim"
    ],
    "acceptedStatuses": ["open", "in-review", "blocked", "closed", "expired"],
    "closedRequires": [
      "named owner",
      "Release Candidate or effective version",
      "immutable evidence path and SHA-256",
      "reviewer or approver",
      "recorded date"
    ]
  },
  "scanRoots": [
    "packages/dashboard/dist",
    "packages/dashboard/aidr-landing.html",
    ".claude-plugin",
    "README.md"
  ],
  "artifactRoots": [
    "packages/claude-code/dist",
    "packages/extension/dist",
    "packages/openclaw/dist",
    "packages/opencode/dist",
    "packages/cli/dist",
    "packages/sdk/dist",
    "packages/dashboard/dist"
  ],
  "licenseCheck": {
    "licensePath": "LICENSE",
    "noticePath": "NOTICE",
    "rootPackagePath": "package.json",
    "workspacePackageRoots": ["packages"],
    "minimumLicenseBytes": 128,
    "noticeLicenseNames": ["Apache License 2.0", "MIT License", "ISC License", "Proprietary"],
    "rootNoticeConflictPairs": [
      { "rootPackageLicense": "Proprietary", "noticeLicense": "Apache License 2.0" },
      { "rootPackageLicense": "Proprietary", "noticeLicense": "MIT License" },
      { "rootPackageLicense": "Proprietary", "noticeLicense": "ISC License" }
    ],
    "firstPartyLicenseTextPaths": ["README.md", "CONTRIBUTING.md", "packages/openclaw/README.md", ".claude-plugin/plugin.json", "packages/extension/LICENSE", "docs/threat-rules.md", "docs/strategy/closed-source-transition-2026.md"],
    "forbiddenFirstPartyLicenseText": ["Source code: [Apache License 2.0]", "dual-license structure", "Apache License 2.0 - Copyright 2026 SingularityRD", "\"license\": \"Apache-2.0\"", "Apache 2.0 source code license"],
    "requiredThirdPartyNoticePaths": ["THIRD_PARTY_NOTICES", "threats/LICENSE", "vendor/ai-infra-guard/LICENSE", "vendor/ai-infra-guard/NOTICE"],
    "requireNoticeReferenceToLicenseFile": true,
    "requirePackageLicenseField": true,
    "legalReviewRequired": true
  },
  "claimPatterns": [
    {
      "id": "CLM-BANNED-LAUNCH",
      "pattern": "\\blaunch[- ]ready\\b|\\bgo live in minutes\\b",
      "reason": "Launch or time-to-value promise requires an approved RC and customer evidence.",
      "defaultStatus": "blocked"
    },
    {
      "id": "CLM-BANNED-SCOPE",
      "pattern": "\\ball (?:agents|platforms|connectors)\\b|\\bfully supported\\b|\\bcomprehensive(?: AI)? security platform\\b",
      "reason": "Universal or comprehensive coverage is not claimable before the supported-platform matrix and independent tests pass.",
      "defaultStatus": "blocked"
    },
    {
      "id": "CLM-BANNED-REALTIME",
      "pattern": "\\breal[- ]time\\b",
      "reason": "Real-time latency requires a measured SLI, workload envelope, sample size, and Release Candidate evidence.",
      "defaultStatus": "blocked"
    },
    {
      "id": "CLM-BANNED-AUTOMATIC",
      "pattern": "\\bautomatic(?:ally)?\\s+(?:quarantine|containment|rollback|response|upgrades?)\\b|\\bauto[- ](?:quarantine|containment|rollback|response|upgrades?)\\b",
      "reason": "Automatic action claims require an enabled, tested, reversible policy and customer-visible limitation.",
      "defaultStatus": "blocked"
    },
    {
      "id": "CLM-BANNED-COMPLIANCE",
      "pattern": "\\b(?:SOC ?2|ISO ?27001|HIPAA|GDPR)\\s*(?:Type II|certified|compliant|compliance)\\b",
      "reason": "Compliance and certification statements require counsel-approved scope and independent attestation; roadmap text is not evidence.",
      "defaultStatus": "blocked"
    },
    {
      "id": "CLM-BANNED-AIG-DATA",
      "pattern": "\\b(?:1,?300\\+|1300\\+)\\s*CVE(?:s)?\\b|\\bzero[- ]false[- ]positive(?:s)?\\b",
      "reason": "Dataset size and quality claims require a signed, non-empty dataset hash and fixture results from the installed consumer.",
      "defaultStatus": "blocked"
    },
    {
      "id": "CLM-BANNED-PRIVACY",
      "pattern": "\\blocal[- ]only\\b|\\bdata never leaves (?:the )?(?:premise|device)\\b|\\bno data leaves\\b",
      "reason": "Privacy claims require field-level payload assertions, outbound-domain inventory, retention, region, and DPA approval.",
      "defaultStatus": "blocked"
    },
    {
      "id": "CLM-BANNED-READINESS",
      "pattern": "\\bproduction[- ]ready\\b|\\bsale[- ]ready\\b|\\benterprise[- ]grade\\b",
      "reason": "Readiness is a signed release decision, not a source or build property.",
      "defaultStatus": "blocked"
    }
  ],
  "hardGates": [
    {
      "id": "COM-001",
      "domain": "commercial",
      "requirement": "Commercial Release Manifest fixes SKU, price, metering, currency/tax, deployment, region, retention, SLA, support, licence rights, renewal, cancellation, and offboarding for the same Release Candidate.",
      "decisionProfiles": ["evaluation", "assisted-sale", "production-ga", "investor"],
      "class": "hard",
      "status": "open",
      "ownerRole": "Commercial/Sales + Finance/Billing",
      "automatedCheck": "claim-check --mode=gate plus signed-manifest verification",
      "evidenceRequired": ["approved manifest", "sample quote/order", "quote-to-offboarding rehearsal", "immutable evidence hash"],
      "waiver": "not-waivable"
    },
    {
      "id": "COM-002",
      "domain": "licensing-ip",
      "requirement": "Licences, notices, attribution, third-party source provenance, chain-of-title, and every shipped package license field are complete and counsel-approved; a non-empty LICENSE must reconcile with NOTICE and package metadata.",
      "decisionProfiles": ["evaluation", "assisted-sale", "production-ga", "investor"],
      "class": "hard",
      "status": "open",
      "ownerRole": "Legal + Engineering",
      "automatedCheck": "claim-check --mode=gate (license/NOTICE/package metadata check) plus licence inventory",
      "evidenceRequired": ["counsel approval", "non-empty LICENSE", "NOTICE/licence bundle", "package-license reconciliation", "first-party documentation licence audit", "source and vendor provenance", "exception register with expiry"],
      "waiver": "not-waivable-for-advertised-rights"
    },
    {
      "id": "COM-003",
      "domain": "privacy",
      "requirement": "Actual telemetry, browser tracing, managed events, AIG payloads, retention, deletion, region, subprocessors, and transfer mechanisms match customer-facing notices and DPA/TOM/SCC terms.",
      "decisionProfiles": ["evaluation", "assisted-sale", "production-ga", "investor"],
      "class": "hard",
      "status": "open",
      "ownerRole": "Privacy/DPO + Legal + Security",
      "automatedCheck": "privacy-payload-contract and outbound-domain/redaction gates",
      "evidenceRequired": ["field-level data-flow matrix", "payload assertion report", "DPA/TOM/SCC approval", "subprocessor/region list", "deletion/export receipt"],
      "waiver": "not-waivable-for-unknown-or-misrepresented-processing"
    },
    {
      "id": "COM-004",
      "domain": "billing-entitlements",
