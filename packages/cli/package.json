{
  "name": "@singularityrd/aidr-cli",
  "version": "0.6.0",
  "description": "AIDR CLI - One-command setup for AI Agent security",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aidr": "./dist/index.js",
    "aidr-setup": "./dist/index.js"
  },
	"files": ["dist", "resources"],
	"scripts": {
		"build": "node ../../scripts/ensure-core-build.mjs && npm run sync:assets && tsc",
		"build:release": "node ../../scripts/rmrf.mjs dist && node ../../scripts/rmrf.mjs tsconfig.tsbuildinfo && npm run sync:assets && tsc -p tsconfig.release.json && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id @singularityrd/aidr-cli && node ../../scripts/check-no-sourcemaps.mjs dist",
		"sync:assets": "node scripts/sync-assets.mjs",
		"test": "vitest run",
		"dev": "tsc --watch",
		"prepack": "node ../../scripts/check-workspace-refs.mjs",
		"prepublishOnly": "pnpm run build:release"
	},
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "@singularityrd/aidr-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-agent",
    "security",
    "claude",
    "cursor",
    "protection"
  ],
  "license": "Proprietary",
  "author": "Singularity R&D"
}
