{
  "name": "@singularityrd/aidr-cli",
  "version": "1.0.0",
  "description": "AIDR CLI - One-command setup for AI Agent security",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aidr": "./bin/aidr.js",
    "aidr-setup": "./bin/aidr.js"
  },
	"scripts": {
		"build": "tsc",
		"build:release": "node ../../scripts/rmrf.mjs dist && node ../../scripts/rmrf.mjs tsconfig.tsbuildinfo && tsc -p tsconfig.release.json",
		"dev": "tsc --watch",
		"prepublish": "npm run build"
	},
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "inquirer": "^9.2.12",
    "better-sqlite3": "^9.4.3",
    "@singularityrd/aidr-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-agent",
    "security",
    "claude",
    "cursor",
    "protection"
  ],
  "license": "MIT",
  "author": "Singularity R&D"
}
