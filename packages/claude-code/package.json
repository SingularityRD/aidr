{
  "name": "@singularityrd/aidr-claude-code",
  "private": true,
  "license": "Proprietary",
  "version": "0.6.0",
  "type": "module",
  "files": [
    "dist/**",
    "resources/**",
    "package.json",
    "{,dist/}aidr-artifact.manifest.{json,sig}",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "aidr-claude-code": "dist/health.cjs"
  },
  "scripts": {
    "build": "node ../../scripts/ensure-core-build.mjs && node ../../scripts/rmrf.mjs dist && pnpm run sync:assets && node esbuild.config.js",
    "build:sea": "node scripts/build-sea.mjs",
    "build:release": "node ../../scripts/rmrf.mjs dist && pnpm run sync:assets && node esbuild.config.js --release && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id claude-code/dist && node ../../scripts/check-no-sourcemaps.mjs dist",
    "clean": "node ../../scripts/rmrf.mjs dist",
    "prepack": "node scripts/ensure-dist.mjs",
    "sync:assets": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@singularityrd/aidr-core": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
