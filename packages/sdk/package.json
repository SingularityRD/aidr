{
  "name": "@singularityrd/aidr-sdk",
  "license": "Proprietary",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.6.0",
  "description": "Singularity AIDR security client and framework-neutral middleware",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**",
    "resources/**",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run sync:assets && node esbuild.config.js && pnpm run build:types",
    "build:release": "pnpm run clean && pnpm run sync:assets && node esbuild.config.js --release && pnpm run build:types && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id sdk/dist && node ../../scripts/check-no-sourcemaps.mjs dist",
    "build:types": "tsc -p tsconfig.release.json --emitDeclarationOnly && node ../../scripts/copy-cjs-types.mjs dist/index.d.ts dist/index.d.cts",
    "clean": "node ../../scripts/rmrf.mjs dist tsconfig.tsbuildinfo tsconfig.release.tsbuildinfo",
    "sync:assets": "node scripts/sync-assets.mjs",
    "prepack": "pnpm run build:types && node ../../scripts/check-workspace-refs.mjs",
    "prepublishOnly": "pnpm run build:release"
  },
  "dependencies": {
    "@singularityrd/aidr-core": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "aidr",
    "security",
    "ai-agent",
    "agent-security",
    "middleware",
    "sdk",
    "ai-safety",
    "malware-detection"
  ]
}
