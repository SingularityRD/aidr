{
  "name": "aidr-cursor",
  "displayName": "Singularity AIDR",
  "description": "%extension.description%",
  "version": "0.6.0",
  "private": true,
  "publisher": "SingularityRD",
  "icon": "aidr-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/singularityrd/aidr.git"
  },
  "license": "Proprietary",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aidr.enableProtection",
    "onCommand:aidr.disableProtection",
    "onCommand:aidr.openConfig",
    "onCommand:aidr.openAuditLog",
    "onCommand:aidr.showHookHealth"
  ],
  "files": [
    "dist/cursor_extension.js",
    "dist/vscode_extension.js",
    "dist/aidr-hook.cjs",
    "dist/aidr-hook.bundle.cjs",
    "dist/aidr-hook-launcher.cjs",
    "dist/aidr-uninstall.cjs",
    "dist/aidr-artifact.manifest.json",
    "dist/aidr-artifact.manifest.sig",
    "dist/aidr-sbom.cdx.json",
    "dist/aidr-sbom.cdx.json.sha256",
    "dist/resources/**",
    "dist/vendor/**",
    "aidr-icon.png",
    "package.nls.json",
    "package.nls.tr.json",
    "l10n/**",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cursor_extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "aidr.enableProtection",
        "title": "%command.enableProtection.title%"
      },
      {
        "command": "aidr.disableProtection",
        "title": "%command.disableProtection.title%"
      },
      {
        "command": "aidr.openConfig",
        "title": "%command.openConfig.title%"
      },
      {
        "command": "aidr.openAuditLog",
        "title": "%command.openAuditLog.title%"
      },
      {
        "command": "aidr.showHookHealth",
        "title": "%command.showHookHealth.title%"
      }
    ],
    "configuration": {
      "title": "Singularity AIDR",
      "properties": {
        "aidr.cursor.scope": {
          "type": "string",
          "default": "user",
          "enum": [
            "workspace",
            "user"
          ],
          "description": "%config.cursorScope.description%"
        },
        "aidr.vscode.scope": {
          "type": "string",
          "default": "user",
          "enum": [
            "workspace",
            "user"
          ],
          "description": "%config.vscodeScope.description%"
        },
        "aidr.hookRunnerPath": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "%config.hookRunnerPath.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./dist/aidr-uninstall.cjs",
    "build": "node ../../scripts/ensure-core-build.mjs && npm run clean && npm run sync:assets && node esbuild.config.cjs",
    "build:release": "npm run clean && npm run sync:assets && node esbuild.config.cjs --release && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id extension/dist && node ../../scripts/check-no-sourcemaps.mjs dist",
    "clean": "node ../../scripts/rmrf.mjs dist resources .vsce",
    "sync:assets": "node scripts/sync-assets.mjs",
    "pretest": "node ../../scripts/ensure-core-build.mjs && npm run sync:assets && node esbuild.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package:cursor:vsix:from-signed-dist": "node scripts/package-cursor-vsix.mjs",
    "package:vscode:vsix:from-signed-dist": "node scripts/package-vscode-vsix.mjs",
    "package:vsix:from-signed-dist": "npm run package:cursor:vsix:from-signed-dist && npm run package:vscode:vsix:from-signed-dist"
  },
  "devDependencies": {
    "@singularityrd/aidr-core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "koffi": "^3.3.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
