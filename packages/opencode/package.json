{
  "name": "@singularityrd/aidr-opencode",
  "license": "Proprietary",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "version": "0.6.0",
  "type": "module",
  "description": "Singularity AIDR - Agent Detection & Response layer for OpenCode",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "resources/**",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/ensure-core-build.mjs && pnpm run clean && pnpm run sync:assets && tsc",
    "build:release": "pnpm run clean && pnpm run sync:assets && tsc -p tsconfig.release.json && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id opencode/dist && node ../../scripts/check-no-sourcemaps.mjs dist",
    "clean": "node ../../scripts/rmrf.mjs dist resources tsconfig.tsbuildinfo tsconfig.release.tsbuildinfo",
    "prepack": "node ../../scripts/check-workspace-refs.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "test": "vitest run",
    "test:aidr-contract": "vitest run src/__tests__/aidr-contract.test.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.10",
    "@singularityrd/aidr-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "security",
    "adr",
    "agent-security",
    "safety",
    "malware-detection"
  ]
}
