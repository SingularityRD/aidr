{
  "name": "@singularityrd/aidr-opencode",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.6.0",
  "type": "module",
  "description": "Singularity AIDR - Agent Detection & Response layer for OpenCode",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "resources/**",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm -C ../core build && pnpm run clean && pnpm run sync:assets && tsc",
    "build:release": "pnpm run clean && pnpm run sync:assets && tsc -p tsconfig.release.json && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id @singularityrd/aidr-opencode && node ../../scripts/check-no-sourcemaps.mjs dist",
    "clean": "node ../../scripts/rmrf.mjs dist resources tsconfig.tsbuildinfo tsconfig.release.tsbuildinfo",
    "prepack": "node ../../scripts/check-workspace-refs.mjs",
    "sync:assets": "node scripts/sync-assets.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@singularityrd/aidr-core": "workspace:*",
    "pino": "^9.6.0",
    "@sentry/node": "^9.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.2.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "security",
    "adr",
    "agent-security",
    "safety",
    "malware-detection"
  ]
}
