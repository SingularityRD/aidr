{
  "name": "@singularityrd/aidr-core",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.6.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:release": "node ../../scripts/rmrf.mjs dist tsconfig.tsbuildinfo tsconfig.release.tsbuildinfo && tsc -p tsconfig.release.json && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id @singularityrd/aidr-core && node ../../scripts/check-no-sourcemaps.mjs .",
    "clean": "node ../../scripts/rmrf.mjs dist tsconfig.tsbuildinfo tsconfig.release.tsbuildinfo",
    "prepack": "node ../../scripts/check-workspace-refs.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.4",
    "zod": "^3.24.0",
    "pino": "^9.6.0",
    "@sentry/node": "^9.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0"
  },
  "optionalDependencies": {
    "koffi": "^2.15.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
