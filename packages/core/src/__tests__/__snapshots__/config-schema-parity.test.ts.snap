    "allow_insecure_loopback": false,
    "enabled": false,
    "timeout_seconds": 2,
  },
  "heuristics_enabled": true,
  "incident": {
    "correlation_enabled": true,
    "enabled": true,
    "store": "jsonl",
  },
  "integrity": {
    "enabled": false,
    "public_keys_pem": [],
    "verify_on_start": true,
  },
  "intel": {
    "enabled": false,
    "url_denylist_path": "~/.singularity-aidr/intel/url_denylist.txt",
  },
  "intel_packs": {
    "cache_ttl_seconds": 60,
    "enabled": false,
    "expired_grace_hours": 72,
    "packs_dir": "~/.singularity-aidr/intel/packs",
    "trusted_keys_path": "~/.singularity-aidr/intel/trusted-keys.json",
    "verify_signatures": true,
  },
  "licensing": {
    "enabled": true,
    "public_keys_pem": [],
    "require_signed_entitlements": true,
    "revocations_cache_path": "~/.singularity-aidr/revocations.json",
    "revocations_enabled": true,
    "revocations_refresh_seconds": 3600,
  },
  "logging": {
    "enabled": true,
    "log_clean": false,
    "max_bytes": 5242880,
    "max_files": 3,
    "path": "~/.singularity-aidr/audit.jsonl",
  },
  "mode": "local",
  "nvd_check": {
    "cache_path": "~/.singularity-aidr/nvd-cache.json",
    "cache_ttl_hours": 6,
    "enabled": true,
    "keywords": [
      "AI",
      "artificial intelligence",
      "machine learning",
      "LLM",
      "large language model",
      "agent",
      "chatbot",
      "OpenClaw",
      "Claude",
      "Claude Code",
      "Cursor",
      "code assistant",
      "AI agent",
      "autonomous agent",
      "MCP",
      "Model Context Protocol",
    ],
    "timeout_seconds": 30,
  },
  "operator_approvals": {
    "dashboard_only": false,
    "exception_trusted_repo_roots": [],
    "key_storage": "os-vault",
    "mode": "host_dialog",
  },
  "package_check": {
    "adoption_lookup": true,
    "enabled": false,
    "low_adoption_max_versions": 3,
    "low_adoption_weekly_downloads": 1000,
    "new_package_days": 30,
    "timeout_seconds": 2,
    "unchecked_action": "allow",
  },
  "poisoning_protection": {
    "agent_control_files": "ask",
    "content_scan": true,
    "enabled": true,
    "memory_write_scan": true,
  },
  "policy": {
    "ai_infrastructure": {
      "critical_action": "block",
      "enabled": false,
      "max_age_seconds": 3600,
      "report_path": "~/.singularity-aidr/infra-scan.json",
      "targets": [],
      "unverified_action": "require_approval",
    },
    "enabled": false,
    "filesystem": {
      "allowed_write_roots": [],
      "deny_write_patterns": [],
      "enabled": false,
      "outside_root_action": "require_approval",
    },
    "mcp": {
      "allow_servers": [],
      "allow_tools": [],
      "default_action": "require_approval",
      "deny_servers": [],
      "deny_tools": [],
      "enabled": false,
      "inventory_paths": [],
      "require_approval_servers": [],
      "require_approval_tools": [],
      "unknown_server_action": "require_approval",
    },
    "network": {
      "allow_domains": [],
      "deny_action": "block",
      "deny_domains": [],
      "deny_private_ips": true,
      "enabled": false,
      "outside_allow_action": "require_approval",
    },
    "runtime_defaults": {},
    "shell": {
      "deny_action": "block",
      "deny_patterns": [],
      "enabled": false,
    },
  },
  "prompt_protection": {
    "content_safety": {
      "hate_harassment": "warn",
      "malware": "warn",
      "phishing_kit": "warn",
      "self_harm": "warn",
      "sexual_minors": "block",
      "weapons_cbrn": "block",
    },
    "jailbreak": "warn",
    "pii": "warn",
    "secrets": "block",
  },
  "response": {
    "actions": {
      "protect_paths": [],
      "snapshot_before_destructive": false,
      "snapshot_dir": "~/.singularity-aidr/response-vault",
      "snapshot_max_bytes": 10485760,
      "snapshot_max_total_bytes": 268435456,
      "snapshot_min_severity": "warning",
      "snapshot_on_deny": false,
      "snapshot_retention_days": 7,
      "snapshot_root_dir": "~/.singularity-aidr/snapshots",
    },
    "audit": {
      "path": "~/.singularity-aidr/response-audit.jsonl",
      "retain_deletion_evidence": true,
      "retention_days": 0,
      "signed_chain": false,
    },
    "emit_incidents": true,
    "quarantine": {
      "dir": "~/.singularity-aidr/quarantine",
      "enabled": false,
      "max_scan_bytes": 2097152,
      "max_total_bytes": 536870912,
      "min_severity": "high",
      "retention_days": 30,
    },
  },
  "secure_code": {
    "action": "warn",
    "enabled": true,
  },
  "sensitivity": "balanced",
  "toxic_flow": {
    "action": "auto",
    "bulk_sensitive_threshold": 5,
    "enabled": true,
    "trusted_domains": [],
    "trusted_git_remotes": [
      "origin",
    ],
    "trusted_mcp_servers": [],
    "window_minutes": 60,
  },
  "url_check": {
    "allow_insecure_loopback": false,
    "enabled": false,
    "include_query_parameters": false,
    "timeout_seconds": 2,
    "unchecked_action": "allow",
  },
  "version_check": {
    "enabled": false,
  },
}
`;

