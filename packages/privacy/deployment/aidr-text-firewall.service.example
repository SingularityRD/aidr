[Unit]
Description=Required host output boundary for AIDR private text service
Before=aidr-text.service

[Service]
Type=oneshot
User=root
ExecStartPre=/usr/sbin/nft --check --file /etc/aidr-privacy/text-service.nft
ExecStart=/usr/sbin/nft --file /etc/aidr-privacy/text-service.nft
RemainAfterExit=yes
# Intentionally no ExecStop which removes rules and opens a bypass.

[Install]
WantedBy=multi-user.target
