# Combined MCP + text profile. Replace every operator-owned UID/address before use.
# Use this INSTEAD OF text-service.nft for these UIDs, not two conflicting tables.
# No global flush; IPv6 is denied for these three UIDs until explicitly approved.
define aidr_service_uid = REPLACE_TEXT_SERVICE_UID
define aidr_host_uid = REPLACE_APPLICATION_UID
define aidr_mcp_uid = REPLACE_MCP_SERVICE_UID
table inet aidr_mcp_text_service {
 set identity_v4 { type ipv4_addr; elements = { REPLACE_APPROVED_IDP_AND_BROKER_IPS } }
 set provider_v4 { type ipv4_addr; elements = { REPLACE_APPROVED_PROVIDER_IPS } }
 set upstream_v4 { type ipv4_addr; elements = { REPLACE_APPROVED_MCP_UPSTREAM_IPS } }
 set resolver_v4 { type ipv4_addr; elements = { REPLACE_APPROVED_DNS_RESOLVER_IPS } }
 chain output {
  type filter hook output priority 0; policy accept;
  meta skuid $aidr_host_uid ip daddr 127.0.0.1 tcp dport { 8443, 7789 } accept
  meta skuid $aidr_host_uid reject
  meta skuid $aidr_mcp_uid ip daddr 127.0.0.1 tcp dport 8443 accept
  meta skuid $aidr_mcp_uid ip daddr 127.0.0.1 tcp sport 7789 accept
  meta skuid $aidr_mcp_uid ip daddr @resolver_v4 udp dport 53 accept
  meta skuid $aidr_mcp_uid ip daddr @resolver_v4 tcp dport 53 accept
  meta skuid $aidr_mcp_uid ip daddr @upstream_v4 tcp dport 443 accept
  meta skuid $aidr_mcp_uid reject
  meta skuid $aidr_service_uid ip daddr @resolver_v4 udp dport 53 accept
  meta skuid $aidr_service_uid ip daddr @resolver_v4 tcp dport 53 accept
  meta skuid $aidr_service_uid ip daddr @identity_v4 tcp dport 443 accept
  meta skuid $aidr_service_uid ip daddr @provider_v4 tcp dport 443 accept
  meta skuid $aidr_service_uid ip daddr 127.0.0.1 tcp sport 8443 accept
  meta skuid $aidr_service_uid reject
 }
}
