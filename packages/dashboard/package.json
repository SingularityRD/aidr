{
  "name": "@singularityrd/aidr-dashboard",
  "license": "Proprietary",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "dist/LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/copy-package-license.mjs .",
    "build:release": "node ../../scripts/rmrf.mjs dist .vite && vite build && node ../../scripts/copy-package-license.mjs . && node ../../scripts/generate-artifact-manifest.mjs --dir dist --artifact-id @singularityrd/aidr-dashboard && node ../../scripts/check-no-sourcemaps.mjs dist",
    "preview": "vite preview",
    "test:route-smoke": "node ../../scripts/dashboard-route-smoke.mjs",
    "test:route-smoke:static": "node ../../scripts/dashboard-route-smoke.mjs --static",
    "clean": "node ../../scripts/rmrf.mjs dist .vite"
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0",
    "@supabase/supabase-js": "^2.108.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
